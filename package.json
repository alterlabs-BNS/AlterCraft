      "scripts": {
            "dev": "vite",
            "audit": "npm audit --audit-level=critical",
            "images:webp": "node scripts/convert-blog-covers.mjs",
            "seo:generate": "node scripts/generate-indexing-assets.mjs",
            "seo:check": "node scripts/check-seo.mjs",
            "operator-desk:server": "node server/operatorDeskServer.mjs",
            "backend:init": "node server/initCentralDb.mjs",
            "backend:server": "node server/centralDbServer.mjs",
            "backend:check": "node server/checkCentralDb.mjs",
            "repo:backup": "powershell -ExecutionPolicy Bypass -File scripts/altereco-safety-backup.ps1",
            "repo:guard:install": "powershell -ExecutionPolicy Bypass -File scripts/install-altereco-git-guard.ps1",
            "repo:release-gates": "node scripts/altereco-release-gates.mjs",
            "build": "npm run seo:generate && vite build && node scripts/postbuild.mjs && node scripts/prerender.mjs",
            "cap:sync": "npm run build && node scripts/remove-build-apks.mjs && cap sync android && node scripts/fix-capacitor-java.mjs",
